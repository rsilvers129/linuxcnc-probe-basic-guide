# XHC WHB04B-6 wireless pendant (added 2026-10-19)
#   Driver: xhc-whb04b-6 (ships with LinuxCNC). USB receiver 10ce:eb93.
#   Permissions: /etc/udev/rules.d/99-xhc-whb04b-6.rules (MODE 0666, GROUP plugdev).
#   Options: -H HAL mode, -s Lead+wheel = spindle override, -f MPG+wheel = feed override, -B adds 5/10 mm steps.
#   Machine axes are X Y Z A; the pendant's B and C positions are left unconnected.
#   Loaded from the end of probe_basic_postgui.hal (QtPyVCP only runs ONE POSTGUI_HALFILE).
#   The USB receiver must stay plugged in: the driver waits for it while LinuxCNC starts.
loadusr -W xhc-whb04b-6 -HsfB

# ---------------------------------------------------------------
# Display: machine and work positions on the pendant LCD
# ---------------------------------------------------------------
net whb-pos-x      halui.axis.x.pos-feedback => whb.halui.axis.x.pos-feedback
net whb-pos-y      halui.axis.y.pos-feedback => whb.halui.axis.y.pos-feedback
net whb-pos-z      halui.axis.z.pos-feedback => whb.halui.axis.z.pos-feedback
net whb-pos-a      halui.axis.a.pos-feedback => whb.halui.axis.a.pos-feedback
net whb-pos-rel-x  halui.axis.x.pos-relative => whb.halui.axis.x.pos-relative
net whb-pos-rel-y  halui.axis.y.pos-relative => whb.halui.axis.y.pos-relative
net whb-pos-rel-z  halui.axis.z.pos-relative => whb.halui.axis.z.pos-relative
net whb-pos-rel-a  halui.axis.a.pos-relative => whb.halui.axis.a.pos-relative

# ---------------------------------------------------------------
# Jog wheel -> axis jog counts (selected axis only, manual mode)
# ---------------------------------------------------------------
net whb-jog-x-counts   whb.axis.x.jog-counts   => axis.x.jog-counts
net whb-jog-x-enable   whb.axis.x.jog-enable   => axis.x.jog-enable
net whb-jog-x-scale    whb.axis.x.jog-scale    => axis.x.jog-scale
net whb-jog-x-velmode  whb.axis.x.jog-vel-mode => axis.x.jog-vel-mode
net whb-jog-y-counts   whb.axis.y.jog-counts   => axis.y.jog-counts
net whb-jog-y-enable   whb.axis.y.jog-enable   => axis.y.jog-enable
net whb-jog-y-scale    whb.axis.y.jog-scale    => axis.y.jog-scale
net whb-jog-y-velmode  whb.axis.y.jog-vel-mode => axis.y.jog-vel-mode
net whb-jog-z-counts   whb.axis.z.jog-counts   => axis.z.jog-counts
net whb-jog-z-enable   whb.axis.z.jog-enable   => axis.z.jog-enable
net whb-jog-z-scale    whb.axis.z.jog-scale    => axis.z.jog-scale
net whb-jog-z-velmode  whb.axis.z.jog-vel-mode => axis.z.jog-vel-mode
net whb-jog-a-counts   whb.axis.a.jog-counts   => axis.a.jog-counts
net whb-jog-a-enable   whb.axis.a.jog-enable   => axis.a.jog-enable
net whb-jog-a-scale    whb.axis.a.jog-scale    => axis.a.jog-scale
net whb-jog-a-velmode  whb.axis.a.jog-vel-mode => axis.a.jog-vel-mode

net whb-sel-x  whb.halui.axis.x.select => halui.axis.x.select
net whb-sel-y  whb.halui.axis.y.select => halui.axis.y.select
net whb-sel-z  whb.halui.axis.z.select => halui.axis.z.select
net whb-sel-a  whb.halui.axis.a.select => halui.axis.a.select

# ---------------------------------------------------------------
# Machine, homing, E-stop reset
# ---------------------------------------------------------------
net whb-machine-on     whb.halui.machine.on  => halui.machine.on
net whb-machine-off    whb.halui.machine.off => halui.machine.off
net whb-machine-is-on  halui.machine.is-on   => whb.halui.machine.is-on
# M-HOME button = home all (the man page lists whb.halui.home-all, but this driver build has no such pin)
net whb-home-all       whb.button.m-home     => halui.home-all
net whb-homed-x        halui.joint.0.is-homed => whb.halui.joint.x.is-homed
net whb-homed-y        halui.joint.1.is-homed => whb.halui.joint.y.is-homed
net whb-homed-z        halui.joint.2.is-homed => whb.halui.joint.z.is-homed
net whb-homed-a        halui.joint.3.is-homed => whb.halui.joint.a.is-homed
# RESET button = software E-stop reset (the physical E-stop button must be released)
net whb-reset          whb.button.reset      => halui.estop.reset

# ---------------------------------------------------------------
# Program run / pause / resume / stop and modes
# ---------------------------------------------------------------
net whb-prog-run     whb.halui.program.run    => halui.program.run
net whb-prog-pause   whb.halui.program.pause  => halui.program.pause
net whb-prog-resume  whb.halui.program.resume => halui.program.resume
net whb-prog-stop    whb.halui.program.stop   => halui.program.stop
net whb-prog-is-running  halui.program.is-running => whb.halui.program.is-running
# is-idle and is-paused already feed Probe Basic signals (an output pin can only be in one signal)
net prog-running  => whb.halui.program.is-idle
net prog-paused   => whb.halui.program.is-paused

net whb-mode-auto        whb.halui.mode.auto    => halui.mode.auto
net whb-mode-manual      whb.halui.mode.manual  => halui.mode.manual
net whb-mode-mdi         whb.halui.mode.mdi     => halui.mode.mdi
net whb-mode-joint       whb.halui.mode.joint   => halui.mode.joint
net whb-mode-teleop      whb.halui.mode.teleop  => halui.mode.teleop
net whb-mode-is-auto     halui.mode.is-auto     => whb.halui.mode.is-auto
net whb-mode-is-manual   halui.mode.is-manual   => whb.halui.mode.is-manual
net whb-mode-is-mdi      halui.mode.is-mdi      => whb.halui.mode.is-mdi
net whb-mode-is-joint    halui.mode.is-joint    => whb.halui.mode.is-joint
net whb-mode-is-teleop   halui.mode.is-teleop   => whb.halui.mode.is-teleop

# ---------------------------------------------------------------
# Spindle (S-ON/OFF toggles; Fn+Spindle+/- changes speed; Spindle+/- = override)
# ---------------------------------------------------------------
net whb-spindle-start    whb.halui.spindle.start    => halui.spindle.0.start
net whb-spindle-stop     whb.halui.spindle.stop     => halui.spindle.0.stop
net whb-spindle-fwd      whb.halui.spindle.forward  => halui.spindle.0.forward
net whb-spindle-rev      whb.halui.spindle.reverse  => halui.spindle.0.reverse
net whb-spindle-inc      whb.halui.spindle.increase => halui.spindle.0.increase
net whb-spindle-dec      whb.halui.spindle.decrease => halui.spindle.0.decrease
net whb-spindle-is-on    halui.spindle.0.is-on      => whb.halui.spindle.is-on
net whb-spindle-ovr-inc  whb.halui.spindle-override.increase => halui.spindle.0.override.increase
net whb-spindle-ovr-dec  whb.halui.spindle-override.decrease => halui.spindle.0.override.decrease
net whb-spindle-ovr-val  halui.spindle.0.override.value      => whb.halui.spindle-override.value
net whb-spindle-ovr-scale whb.halui.spindle-override.scale   => halui.spindle.0.override.scale
# commanded rpm shown on the pendant (spindle-speed-abs already exists in 6040_7i96s.hal)
net spindle-speed-abs   => whb.halui.spindle-speed-cmd

# ---------------------------------------------------------------
# Feed override and jog velocity
# ---------------------------------------------------------------
net whb-feed-ovr-inc    whb.halui.feed-override.increase => halui.feed-override.increase
net whb-feed-ovr-dec    whb.halui.feed-override.decrease => halui.feed-override.decrease
net whb-feed-ovr-scale  whb.halui.feed-override.scale    => halui.feed-override.scale
net whb-feed-ovr-val    halui.feed-override.value        => whb.halui.feed-override.value
net whb-max-vel         halui.max-velocity.value         => whb.halui.max-velocity.value

# ---------------------------------------------------------------
# Buttons that run MDI commands ([HALUI] MDI_COMMAND order in the INI)
#   00 Safe-Z  = G53 G0 Z0
#   01 W-Home  = o<go_to_zero> call  (Z up, then work X0 Y0 A0)
#   02 Probe-Z = o<touch_plate> call (puck touch-off)
# ---------------------------------------------------------------
net whb-safe-z   whb.button.safe-z  => halui.mdi-command-00
net whb-w-home   whb.button.w-home  => halui.mdi-command-01
net whb-probe-z  whb.button.probe-z => halui.mdi-command-02
